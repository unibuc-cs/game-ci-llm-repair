<mxfile host="app.diagrams.net">
  <diagram name="Flow" id="symptom-arch-flow">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Static Phase -->
        <mxCell id="staticPhase" value="Static phase (per commit)&#10;- Source index (Roslyn, clangd)&#10;- 1-hop call graph&#10;- API/ref checks&#10;- Complexity/smells&#10;- VGFE stats" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="40" width="250" height="160" as="geometry"/>
        </mxCell>

        <!-- Dynamic Phase -->
        <mxCell id="dynamicPhase" value="Dynamic phase (per trial)&#10;- Run tests/scenes&#10;- Collect:&#10; * tests_failed&#10; * exceptions&#10; * perf counters&#10; * invariants" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="40" width="250" height="180" as="geometry"/>
        </mxCell>

        <!-- Cached -->
        <mxCell id="cached" value="CACHED: static_features, visual_graph" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1f5fe;" vertex="1" parent="1">
          <mxGeometry x="180" y="230" width="300" height="50" as="geometry"/>
        </mxCell>

        <!-- Symptom Card -->
        <mxCell id="symptomCard" value="Symptom Card (JSON)&#10;core: tests_failed, exceptions, perf, invariants, static_features, visual_graph, context_map" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e1;" vertex="1" parent="1">
          <mxGeometry x="180" y="300" width="360" height="120" as="geometry"/>
        </mxCell>

        <!-- Hints fuse -->
        <mxCell id="hintsFuse" value="Hints fuse&#10;deterministic merge:&#10;auto + domain + human" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f8e9;" vertex="1" parent="1">
          <mxGeometry x="260" y="450" width="200" height="80" as="geometry"/>
        </mxCell>

        <!-- Architecture Card -->
        <mxCell id="archCard" value="Architecture Card (YAML)&#10;- invariants, perf&#10;- allowed components&#10;- touchlists, gates" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="580" width="250" height="140" as="geometry"/>
        </mxCell>

        <!-- Trial policy -->
        <mxCell id="trialPolicy" value="Trial policy (T0..T3):&#10;- context, gates&#10;- allowed_actions" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="580" width="250" height="120" as="geometry"/>
        </mxCell>

        <!-- Prompt Assembly -->
        <mxCell id="prompt" value="PROMPT ASSEMBLY&#10;(code context + Symptom Card + Arch Card + Trial policy)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ede7f6;" vertex="1" parent="1">
          <mxGeometry x="220" y="750" width="300" height="80" as="geometry"/>
        </mxCell>

        <!-- LLM Patch -->
        <mxCell id="llmPatch" value="LLM patch (diff)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;" vertex="1" parent="1">
          <mxGeometry x="280" y="860" width="180" height="60" as="geometry"/>
        </mxCell>

        <!-- Patch Application -->
        <mxCell id="patchApply" value="Patch application &amp; CI gates&#10;- validate allowlists&#10;- asset validators&#10;- Build → Unit → Integration → Perf → Invariants&#10;(stop on first fail)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;" vertex="1" parent="1">
          <mxGeometry x="150" y="950" width="400" height="120" as="geometry"/>
        </mxCell>

        <!-- Repair Card UI -->
        <mxCell id="repairCard" value="Repair Card UI (HITL)&#10;- show card, neighbors&#10;- policy excerpt&#10;- diffs, metrics&#10;Actions: Run T2, Promote T3, Open Nbrs, Show Diff, Save Tmpl" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;" vertex="1" parent="1">
          <mxGeometry x="220" y="1110" width="300" height="140" as="geometry"/>
        </mxCell>

        <!-- Connections -->
        <mxCell id="edge1" edge="1" parent="1" source="staticPhase" target="cached"/>
        <mxCell id="edge2" edge="1" parent="1" source="dynamicPhase" target="cached"/>
        <mxCell id="edge3" edge="1" parent="1" source="cached" target="symptomCard"/>
        <mxCell id="edge4" edge="1" parent="1" source="symptomCard" target="hintsFuse"/>
        <mxCell id="edge5" edge="1" parent="1" source="hintsFuse" target="archCard"/>
        <mxCell id="edge6" edge="1" parent="1" source="hintsFuse" target="trialPolicy"/>
        <mxCell id="edge7" edge="1" parent="1" source="archCard" target="prompt"/>
        <mxCell id="edge8" edge="1" parent="1" source="trialPolicy" target="prompt"/>
        <mxCell id="edge9" edge="1" parent="1" source="prompt" target="llmPatch"/>
        <mxCell id="edge10" edge="1" parent="1" source="llmPatch" target="patchApply"/>
        <mxCell id="edge11" edge="1" parent="1" source="patchApply" target="repairCard"/>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
